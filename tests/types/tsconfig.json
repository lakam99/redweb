{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": false,
    "baseUrl": "../..",
    "paths": {
      "redweb": ["."],
      "redweb/*": ["*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "redweb"
  },
  "files": ["public-api.ts", "jsx-api.tsx", "socket-contract.ts"]
}
